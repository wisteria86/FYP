# Application
APP_ENV=development
DATABASE_PATH=data/hikari.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
AUTH_COOKIE_NAME=hikari_session
AUTH_SESSION_HOURS=168
ALLOW_DEMO_ACCESS=false

# LLM Settings
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL_NAME=qwen/qwen3.8-27b
LLM_BASE_URL=https://api.groq.com/openai/v1
COMMUNICATION_LANGUAGE=English

# Whisper Settings
STT_ENGINE=auto
STT_DEVICE=auto
STT_CPU_THREADS=4
WHISPER_ONNX_CACHE_DIR=models/whisper_onnx
# NVIDIA Nemotron for English on CUDA; Whisper medium on CPU or other languages.
NEMOTRON_MODEL_DIR=models/nemotron/sherpa-onnx-nemotron-speech-streaming-en-0.6b-560ms-int8-2026-04-25
WHISPER_MODEL_SIZE=medium
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
WHISPER_CACHE_DIR=models/whisper

# Kokoro TTS Settings (used when TTS_ENGINE=kokoro, the default)
# KOKORO_LANG=a
# KOKORO_VOICE=af_heart

# Audio IO Settings
SAMPLE_RATE=16000
RECORD_SECONDS=0
HEADSET_MODE=False
MIC_DEVICE=

# Kokoro is the low-latency default. It can be changed from Settings at runtime.
TTS_ENGINE=kokoro
TTS_SPEED=1

# VITS Japanese TTS Settings (only active when TTS_ENGINE=vits_ja)
# Back on Tsukuyomi-chan (confirmed female) - CSS10-ja turned out male on
# listening test, and no other public piper-plus female JA voice was found
# after thorough search. Focus is now on making Tsukuyomi-chan itself clear
# (see VitsJaTTS.synthesize()'s clause-splitting/silence-splicing).
VITS_JA_HF_REPO_ID=ayousanz/piper-plus-tsukuyomi-chan
VITS_JA_ONNX_FILE=tsukuyomi-chan-6lang-fp16.onnx
VITS_JA_CONFIG_FILE=config.json
VITS_JA_HF_REVISION=main
VITS_JA_CACHE_DIR=models/vits_ja
VITS_JA_SPEAKER_ID=0
VITS_JA_SAMPLE_RATE=22050
VITS_JA_QUANTIZE=True

# ONNX Runtime Settings
ORT_INTRA_THREADS=0
ORT_INTER_THREADS=0

# HuggingFace

HF_TOKEN=your_huggingface_token_here

# ChatTTS memory-safe runtime settings
CHAT_TTS_DEVICE=auto
# Set cuda:0 to require GPU acceleration and fail loudly instead of falling back to CPU.
CHAT_TTS_MODEL_SOURCE=huggingface
CHAT_TTS_CACHE_DIR=models/chattts
HF_HOME=models/huggingface
CHAT_TTS_SPEAKER_SEED=9001
CHAT_TTS_MAX_NEW_TOKENS=512
CHAT_TTS_CPU_THREADS=4
CHAT_TTS_STREAM_BATCH=12
CHAT_TTS_ENABLE_CACHE=True
ENABLE_THINKING_AUDIO=False
WHISPER_CPU_THREADS=4
WHISPER_WORKERS=1

# Explicit platform administrators. Never inferred from organization ownership.
ADMIN_EMAILS=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_CACHE_DIR=models/embeddings
TTS_WARMUP=true
KOKORO_CPU_THREADS=4
