# Application
APP_ENV=development
DATABASE_PATH=data/hikari.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
AUTH_COOKIE_NAME=hikari_session
AUTH_SESSION_HOURS=168
ALLOW_DEMO_ACCESS=false

# LLM Settings
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL_NAME=qwen/qwen3.8-27b
LLM_BASE_URL=https://api.groq.com/openai/v1
COMMUNICATION_LANGUAGE=English

# English recognition: CPU works without NVIDIA/CUDA. No Whisper fallback.
STT_ENGINE=nemotron
STT_DEVICE=cpu
STT_CPU_THREADS=4
WHISPER_ONNX_CACHE_DIR=models/whisper_onnx
# Download once with: python scripts/setup_nemotron.py
# Optional CUDA requires requirements-nemotron.txt and a compatible NVIDIA GPU.
# Whisper settings below apply only when explicitly selecting Whisper/auto.
NEMOTRON_MODEL_DIR=models/nemotron/sherpa-onnx-nemotron-speech-streaming-en-0.6b-560ms-int8-2026-04-25
WHISPER_MODEL_SIZE=medium
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
WHISPER_CACHE_DIR=models/whisper

# Kokoro TTS Settings (used only when TTS_ENGINE=kokoro)
# KOKORO_LANG=a
# KOKORO_VOICE=af_heart

# Audio IO Settings
SAMPLE_RATE=16000
RECORD_SECONDS=0
HEADSET_MODE=False
MIC_DEVICE=

# Piper is the CPU English default; downloads its model on first use.
# Change engine in Settings. Existing saved runtime settings can override this.
TTS_ENGINE=piper
TTS_SPEED=1

# VITS Japanese TTS Settings (only active when TTS_ENGINE=vits_ja)
# Back on Tsukuyomi-chan (confirmed female) - CSS10-ja turned out male on
# listening test, and no other public piper-plus female JA voice was found
# after thorough search. Focus is now on making Tsukuyomi-chan itself clear
# (see VitsJaTTS.synthesize()'s clause-splitting/silence-splicing).
VITS_JA_HF_REPO_ID=ayousanz/piper-plus-tsukuyomi-chan
VITS_JA_ONNX_FILE=tsukuyomi-chan-6lang-fp16.onnx
VITS_JA_CONFIG_FILE=config.json
VITS_JA_HF_REVISION=main
VITS_JA_CACHE_DIR=models/vits_ja
VITS_JA_SPEAKER_ID=0
VITS_JA_SAMPLE_RATE=22050
VITS_JA_QUANTIZE=True

# ONNX Runtime Settings
ORT_INTRA_THREADS=0
ORT_INTER_THREADS=0

# HuggingFace

HF_TOKEN=your_huggingface_token_here

# ChatTTS memory-safe runtime settings
CHAT_TTS_DEVICE=auto
# Set cuda:0 to require GPU acceleration and fail loudly instead of falling back to CPU.
CHAT_TTS_MODEL_SOURCE=huggingface
CHAT_TTS_CACHE_DIR=models/chattts
HF_HOME=models/huggingface
CHAT_TTS_SPEAKER_SEED=9001
CHAT_TTS_MAX_NEW_TOKENS=512
CHAT_TTS_CPU_THREADS=4
CHAT_TTS_STREAM_BATCH=12
CHAT_TTS_ENABLE_CACHE=True
ENABLE_THINKING_AUDIO=False
WHISPER_CPU_THREADS=4
WHISPER_WORKERS=1

# Explicit platform administrators. Never inferred from organization ownership.
ADMIN_EMAILS=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_CACHE_DIR=models/embeddings
TTS_WARMUP=true

# Kokoro: optional existing ONNX model (relative to the server working directory).
# Leave empty to download/use models/kokoro-v1.0.onnx. Custom files are never replaced.
KOKORO_MODEL_PATH=
# 0 lets ONNX Runtime choose; compare against 4 using identical text after warmup.
KOKORO_CPU_THREADS=0
# Maximum text characters synthesized before yielding the next audio chunk.
KOKORO_CHUNK_CHARS=180
# Optional provider override, e.g. CPUExecutionProvider. Must be installed/available.
# ONNX_PROVIDER=CPUExecutionProvider

# Optional English TTS engines; select Piper/Kitten in Settings.
# Models download on first selection. Custom directories must contain extracted packages.
PIPER_CPU_THREADS=2
PIPER_SPEAKER_ID=0
# PIPER_MODEL_DIR=models/tts/vits-piper-en_US-amy-low
KITTEN_CPU_THREADS=2
KITTEN_SPEAKER_ID=0
# KITTEN_MODEL_DIR=models/tts/kitten-nano-en-v0_8-int8

# Nemotron cache flush padding. Keep 1.0 until shorter values pass ending-word tests.
NEMOTRON_FINAL_PADDING_SECONDS=1.0
# Extra flush ceiling only when non-silent speech still yields no text.
NEMOTRON_EMPTY_PADDING_SECONDS=3.0

# Microphone, suppression, gain, manual/automatic input and decoder preferences
# are saved per browser in Settings, not in this file. Greedy works with the
# pinned runtime; beam requires a compatible newer build.
